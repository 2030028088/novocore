# 生产环境环境变量配置示例
# 将此文件复制为 .env 并填写实际值

# 服务器配置
SERVER_PORT=8080

# 数据库配置
DB_URL=jdbc:mysql://localhost:3306/aurora_blog?useUnicode=true&characterEncoding=utf8&useSSL=true&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# JWT配置
JWT_SECRET=your-strong-secret-key-at-least-32-characters-long-must-be-base64-or-random-string
JWT_EXPIRATION=86400000

# 邮件配置
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USERNAME=your_email@qq.com
MAIL_PASSWORD=your_email_password

# 上传配置
UPLOAD_DIR=/data/aurora-blog/uploads

# 日志配置
LOG_LEVEL=INFO

# Swagger配置（生产环境建议关闭）
SWAGGER_ENABLED=false
